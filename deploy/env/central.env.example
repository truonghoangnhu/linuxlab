# Task 15 Task 12 (spec section 20): reference production environment file
# for LinuxLab Central.
#
# This is a TEMPLATE. Copy it to /etc/linuxlab/central.env on the target
# host, fill in real values, and set restrictive permissions:
#   install -o linuxlab -g linuxlab -m 0600 /dev/null /etc/linuxlab/central.env
# Never commit the filled-in file to Git.

DJANGO_SETTINGS_MODULE=linuxlab.settings.central
DJANGO_SECRET_KEY=changeme-generate-a-unique-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=central.example.org

POSTGRES_USER=linuxlab
POSTGRES_PASSWORD=changeme-generate-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=linuxlab_central

WAGTAILADMIN_BASE_URL=https://central.example.org

# Central signing private key for .llpkg packages lives outside the
# repository and outside the database (ADR-010), for example under
# /etc/linuxlab/keys/package-signing.key with mode 0600. It is never
# referenced by this environment file.
