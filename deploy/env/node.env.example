# Task 15 Task 12 (spec section 20): reference production environment file
# for a LinuxLab Node classroom deployment.
#
# This is a TEMPLATE. On the target host:
#   1. sudo install -m 0600 -o linuxlab -g linuxlab /dev/null /etc/linuxlab/node.env
#   2. sudoedit /etc/linuxlab/node.env   -- fill in real values from this template
# Always create the destination first (step 1) and edit it after (step 2):
# running step 1 again after step 2 would truncate whatever was just edited.
# Never commit the filled-in file to Git.

DJANGO_SETTINGS_MODULE=linuxlab.settings.node
DJANGO_SECRET_KEY=changeme-generate-a-unique-random-secret-key
DJANGO_DEBUG=false

# node.example.invalid is an example placeholder (the .invalid TLD is
# reserved for examples -- it will never resolve). Replace it with this
# Node's actual classroom DNS name or LAN IP, and update BOTH
# DJANGO_ALLOWED_HOSTS and WAGTAILADMIN_BASE_URL below consistently, e.g.:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.10.20.5
#   WAGTAILADMIN_BASE_URL=http://10.10.20.5:8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,node.example.invalid

POSTGRES_USER=linuxlab
POSTGRES_PASSWORD=changeme-generate-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=linuxlab_node

# Must describe the classroom-facing endpoint learners actually connect to
# (Node Caddy's :8080 listener, see Caddyfile.node.example) -- not the
# loopback Gunicorn address -- and its host must match DJANGO_ALLOWED_HOSTS
# above.
WAGTAILADMIN_BASE_URL=http://node.example.invalid:8080

# Node -> Central sync (Task 14). This Node must be provisioned by Central
# first; LINUXLAB_NODE_ID and LINUXLAB_SYNC_SECRET are issued by Central
# during that provisioning step, not chosen locally.
LINUXLAB_SYNC_ENABLED=false
LINUXLAB_NODE_ID=changeme-uuid-issued-by-central
LINUXLAB_SYNC_SECRET=changeme-bearer-secret-issued-by-central
LINUXLAB_CENTRAL_URL=https://central.example.org
LINUXLAB_SYNC_ALLOW_INSECURE_HTTP=false

# Optional sync tuning -- safe defaults apply if left unset.
# LINUXLAB_SYNC_BATCH_MAX_EVENTS=100
# LINUXLAB_SYNC_BATCH_MAX_BYTES=1000000
# LINUXLAB_SYNC_LEASE_SECONDS=300
# LINUXLAB_SYNC_BACKOFF_BASE_SECONDS=5
# LINUXLAB_SYNC_BACKOFF_CAP_SECONDS=3600
