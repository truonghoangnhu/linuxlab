# Task 15 Task 12 (spec section 20): reference production environment file
# for a LinuxLab Node classroom deployment.
#
# This is a TEMPLATE. Copy it to /etc/linuxlab/node.env on the target host,
# fill in real values, and set restrictive permissions:
#   install -o linuxlab -g linuxlab -m 0600 /dev/null /etc/linuxlab/node.env
# Never commit the filled-in file to Git.

DJANGO_SETTINGS_MODULE=linuxlab.settings.node
DJANGO_SECRET_KEY=changeme-generate-a-unique-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_USER=linuxlab
POSTGRES_PASSWORD=changeme-generate-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=linuxlab_node

WAGTAILADMIN_BASE_URL=http://localhost:8080

# Node -> Central sync (Task 14). This Node must be provisioned by Central
# first; LINUXLAB_NODE_ID and LINUXLAB_SYNC_SECRET are issued by Central
# during that provisioning step, not chosen locally.
LINUXLAB_SYNC_ENABLED=false
LINUXLAB_NODE_ID=changeme-uuid-issued-by-central
LINUXLAB_SYNC_SECRET=changeme-bearer-secret-issued-by-central
LINUXLAB_CENTRAL_URL=https://central.example.org
LINUXLAB_SYNC_ALLOW_INSECURE_HTTP=false

# Optional sync tuning -- safe defaults apply if left unset.
# LINUXLAB_SYNC_BATCH_MAX_EVENTS=100
# LINUXLAB_SYNC_BATCH_MAX_BYTES=1000000
# LINUXLAB_SYNC_LEASE_SECONDS=300
# LINUXLAB_SYNC_BACKOFF_BASE_SECONDS=5
# LINUXLAB_SYNC_BACKOFF_CAP_SECONDS=3600
