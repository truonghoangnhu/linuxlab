DJANGO_SETTINGS_MODULE=linuxlab.settings.central
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_USER=linuxlab
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# POSTGRES_DB overrides the profile default (linuxlab_central_dev,
# linuxlab_node_dev, or linuxlab_test); leave unset to use the default.
# POSTGRES_DB=linuxlab_central_dev

WAGTAILADMIN_BASE_URL=http://localhost:8000
